{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "Where Australia's dinosaurs are found", "subtitle": "Number of different dinosaur genera found in each state", "anchor": "start"},
  "width": "container",
  "height": 500,
  "projection": {"type": "mercator", "center": [134, -28], "scale": 700},
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/vraj888/3179_S2_2026_08/main/dvp2/js/au-states-topo.json",
        "format": {"type": "topojson", "feature": "austates"}
      },
      "mark": {"type": "geoshape", "fill": "#ece6dc", "stroke": "white"},
      "encoding": {
        "tooltip": [{"field": "properties.STATE_NAME", "type": "nominal", "title": "State or territory"}]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/vraj888/3179_S2_2026_08/main/dvp2/data/dinosauria_all.csv",
        "format": {"type": "csv", "parse": {"max_ma": "number"}}
      },
      "transform": [
        {"filter": "datum.cc === 'AU' && datum.state && datum.max_ma > 66"},
        {"aggregate": [
            {"op": "distinct", "field": "genus", "as": "genera"},
            {"op": "count", "as": "fossils"}
          ],
         "groupby": ["state"]},
        {"lookup": "state",
         "from": {
           "data": {
             "url": "https://raw.githubusercontent.com/vraj888/3179_S2_2026_08/main/dvp2/js/au-states-topo.json",
             "format": {"type": "topojson", "feature": "austates"}
           },
           "key": "properties.STE_NAME21"
         },
         "as": "geo"},
        {"filter": "isValid(datum.geo)"}
      ],
      "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 1},
      "encoding": {
        "shape": {"field": "geo", "type": "geojson"},
        "color": {"field": "genera", "type": "quantitative", "title": "Different genera",
                  "scale": {"scheme": "yelloworangebrown"},
                  "legend": {"orient": "bottom-left"}},
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State or territory"},
          {"field": "genera", "type": "quantitative", "title": "Different genera"},
          {"field": "fossils", "type": "quantitative", "title": "Fossil records"}
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/vraj888/3179_S2_2026_08/main/dvp2/js/ne_10m_rivers_australia.json",
        "format": {"type": "topojson", "feature": "ne_10m_rivers_australia"}
      },
      "mark": {"type": "geoshape", "filled": false, "stroke": "lightblue", "strokeWidth": 0.6}
    }
  ]
}