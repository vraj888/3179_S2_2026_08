{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "data": {
    "url": "https://raw.githubusercontent.com/vraj888/3179_S2_2026_08/main/dvp2/data/dinosauria_all.csv",
    "format": {"type": "csv"}
  },
  "params": [
    {
      "name": "scale_exp",
      "value": 0.25,
      "bind": {
        "input": "select",
        "options": [1, 0.5, 0.25],
        "labels": ["Linear", "Square root", "Compressed (log-like)"],
        "name": "Y-axis scale: ",
        "element": "#scaleControl"
      }
    }

  ],
  "vconcat":[
    {
        "title":{
          "text":"Use this range brush to filter values based on their age"
        },
      "width": "container",
      "height": 40,
      "data": {"values": [
        {"period": "Triassic",   "start_ma": 251.9, "end_ma": 201.4},
        {"period": "Jurassic",   "start_ma": 201.4, "end_ma": 145},
        {"period": "Cretaceous", "start_ma": 145,   "end_ma": 66},
        {"period": "Paleogene",  "start_ma": 66,    "end_ma": 23.03},
        {"period": "Neogene",    "start_ma": 23.03, "end_ma": 2.58},
        {"period": "Quaternary", "start_ma": 2.58,  "end_ma": 0}
      ]},
      "transform": [
        {"calculate": "'Period'", "as": "row"},
        {"calculate": "(datum.start_ma + datum.end_ma) / 2", "as": "mid"}
       
      ],
      "layer": [
        {
          "params": [{"name": "periodSel", "select": {"type": "interval", "encodings": ["x"]}}],
          "mark": {"type": "rect", "cursor": "pointer", "stroke": "white", "strokeWidth": 1},
          
          "encoding": {
            "x": {"field": "start_ma", "type": "quantitative",
                  "scale": {"reverse": false, "domain": [252, 0], "nice": false},
                  "axis": {"title": "Millions of years ago"}},
            "x2": {"field": "end_ma"},
            "y": {"field": "row", "type": "nominal",
                  "axis": {"title": null, "labels": false, "ticks": false, "domain": false, "minExtent": 50}},
            "color": {"field": "period", "type": "nominal", "legend": null,
              "scale": {"scheme":"browns"}},
            "opacity": {"condition": {"param": "periodSel", "value": 1}, "value": 0.4}
          }
        },
        {
          "data": {
          "url": "https://raw.githubusercontent.com/vraj888/3179_S2_2026_08/main/dvp2/data/dinosauria_all.csv",
          "format": {"type": "csv"}
        },
          "transform": [
        {
          "calculate": "(toNumber(datum.max_ma) + toNumber(datum.min_ma)) / 2",
          "as": "mid_ma"
        },
        {
          "calculate": "floor(datum.mid_ma / 5) * 5 + 2.5",
          "as": "time_bin"
        },
        {
          "aggregate": [{"op": "count", "as": "observations"}],
          "groupby": ["time_bin"]
        }],
        "mark": {
          "type": "line",
          "color": "#867B6F",
          "strokeWidth": 2,
          "clip": true
        },
        "encoding": {
          "x": {
            "field": "time_bin",
            "type": "quantitative",
            "axis": {"title": "Millions of years ago"}
          },
          "y": {
            "field": "observations",
            "type": "quantitative",
            "title": "Number of observations",
            "scale": {"type": "pow", "exponent": {"expr": "scale_exp"}}
          },
          "tooltip": [
            {"field": "time_bin", "type": "quantitative", "title": "Time (Ma)"},
            {"field": "observations", "type": "quantitative", "title": "Observations"}
          ]
        }
      },
        {
          "transform": [{"filter": "datum.start_ma - datum.end_ma > 20"}],
          "mark": {"type": "text", "fontSize": 12, "fontWeight": "bold", "color": "black"},
          "encoding": {
            "x": {"field": "mid", "type": "quantitative",
                  "scale": {"reverse": true, "domain": [252, 0], "nice": false}},
            "y": {"field": "row", "type": "nominal"},
            "text": {"field": "period"}
          }
        }
      ]
    },
    {
    "width":"container",
    "height": 250,
    "transform": [
    {
      "calculate": "(toNumber(datum.max_ma) + toNumber(datum.min_ma)) / 2",
      "as": "mid_ma"
    },
    {
      "calculate": "floor(datum.mid_ma / 5) * 5 + 2.5",
      "as": "time_bin"
    },
    {
      "aggregate": [{"op": "count", "as": "observations"}],
      "groupby": ["time_bin"]
    }
  ],
  "layer": [
      {
        "mark": {
          "type": "line",
          "color": "#867B6F",
          "strokeWidth": 2,
          "clip": true,
          "point": {"filled": true, "size": 28, "color": "#A8582A"}
        },
        "encoding": {
          "x": {
            "field": "time_bin",
            "type": "quantitative",
            "scale": {"domain": {"param": "periodSel", "encoding": "x"}, "reverse": true, "nice": false},
            "axis": {"title": "Millions of years ago"}
          },
          "y": {
            "field": "observations",
            "type": "quantitative",
            "title": "Number of observations",
            "scale": {"type": "pow", "exponent": {"expr": "scale_exp"}}
          },
          "tooltip": [
            {"field": "time_bin", "type": "quantitative", "title": "Time (Ma)"},
            {"field": "observations", "type": "quantitative", "title": "Observations"}
          ]
        }
      },
      {
        "mark": {"type": "rule", "strokeDash": [5, 4], "color": "#333", "clip": true},
        "encoding": {
          "x": {"datum": 66, "type": "quantitative",
                "scale": {"domain": {"param": "periodSel", "encoding": "x"}, "reverse": true, "nice": false}}
        }
      },
      {
        "mark": {"type": "text", "align": "left", "dx": 6, "y": 8, "fontSize": 11, "clip": true},
        "encoding": {
          "x": {"datum": 66, "type": "quantitative",
                "scale": {"domain": {"param": "periodSel", "encoding": "x"}, "reverse": true, "nice": false}},
          "text": {"value": "Asteroid, 66 million years ago"}
        }
      }
    ]
  },
  {
    "title":"Location of discoveries from the selected time range.",
    "width": "container",
  "height": 450,
  "projection": {
  "type": "equalEarth"
    },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/ne_110m_admin_0_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
      },
      "mark": {"type": "geoshape", "fill": "#F5F0E6", "stroke": "#b8a99a"}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/7_others/oceans.topojson",
        "format": {"type": "topojson", "feature": "oceans"}
      },
      "mark": {"type": "geoshape", "fill": "#867B6F"}
    },
  
    {
      "data": {
        "url": "https://raw.githubusercontent.com/vraj888/3179_S2_2026_08/refs/heads/main/dvp2/data/dinosauria_all.csv",
        "format": {"type": "csv"}
      },

      "mark": {"type": "circle", "color": "#A8582A", "opacity": 0.5, "size": 10},
      "transform": [
        {
          "calculate": "(toNumber(datum.max_ma) + toNumber(datum.min_ma)) / 2",
          "as": "mid_ma"
        },
        {"calculate": "datum.mid_ma", "as": "start_ma"},
        {"filter": {"param": "periodSel"}}
      ],
      "encoding": {
        "longitude": {"field": "lng", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "tooltip": [{"field": "mid_ma", "type": "quantitative", "title": "Approx. age (Ma)"}]
      }
    }
  ]
  },
  {
    "title":"Australian discoveries from the selected time range.",
    "width": "container",
  "height": 450,
  "projection": {
  "type": "mercator",
  "center": [140, -10],
  "scale": 680
    },
  "layer": [
    {
            "data": {
                "url": "https://raw.githubusercontent.com/vraj888/3179_S2_2026_08/refs/heads/main/dvp2/js/au-states-topo.json",
                "format": {
                    "type": "topojson",
                    "feature": "austates"
                }
            },
            "mark": {
                "type": "geoshape",
                "fill": "#F5F0E6",
                "stroke": "#b8a99a"
            }
        },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/7_others/oceans.topojson",
        "format": {"type": "topojson", "feature": "oceans"}
      },
      "mark": {"type": "geoshape", "fill": "#867B6F"}
    },
  
    {
      "data": {
        "url": "https://raw.githubusercontent.com/vraj888/3179_S2_2026_08/refs/heads/main/dvp2/data/dinosauria_all.csv",
        "format": {"type": "csv"}
      },

      "mark": {"type": "circle", "color": "#A8582A", "opacity": 0.5, "size": 60},
      "transform": [
        {
          "calculate": "(toNumber(datum.max_ma) + toNumber(datum.min_ma)) / 2",
          "as": "mid_ma"
        },
        {"calculate": "datum.mid_ma", "as": "start_ma"},
        {"filter": {"param": "periodSel"}}
      ],
      "encoding": {
        "longitude": {"field": "lng", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "tooltip": [{"field": "mid_ma", "type": "quantitative", "title": "Approx. age (Ma)"}]
      }
    }
  ]
  },
  {
  "title":"Top 5 fossils in the selected time range.",
 "width": "container",
 "height": 200,
 
 "transform": [
  {
    "calculate": "(toNumber(datum.max_ma) + toNumber(datum.min_ma)) / 2",
    "as": "mid_ma"
  },
  {"calculate": "datum.mid_ma", "as": "start_ma"},
  {"filter": {"param": "periodSel"}},
  {"filter":"datum.accepted_rank === 'genus'"},
  {
   "aggregate": [
    {
     "op": "count",
     "as": "count"
    }
   ],
   "groupby": [
    "accepted_name"
   ]
  },
  {
   "window": [
    {
     "op": "row_number",
     "as": "rank"
    }
   ],
   "sort": [
    {
     "field": "count",
     "order": "descending"
    }
   ]
  },
  {
   "filter": "datum.rank <= 5"
  },
  {
   "calculate": "datum.rank === 5 ? 1 : (datum.rank - 1) % 3",
   "as": "col"
  },
  {
   "calculate": "floor((datum.rank - 1) / 3)",
   "as": "row"
  }
 ],
 "encoding": {
  "x": {
   "field": "col",
   "type": "quantitative",
   "axis": null,
   "scale": {
    "domain": [
     -0.5,
     2.5
    ]
   }
  },
  "y": {
   "field": "row",
   "type": "quantitative",
   "axis": null,
   "scale": {
    "domain": [
     3.5,
     -0.5
    ]
   }
  }
 },
 "layer": [
  {
   "mark": {
    "type": "text",
    "align": "center",
    "baseline": "middle",
    "fontWeight": "bold"
   },
   "encoding": {
    "text": {
     "field": "accepted_name",
     "type": "nominal"
    },
    "size": {
     "field": "count",
     "type": "quantitative",
     "scale": {
      "type": "sqrt",
      "zero": true,
      "range": [
       0,
       40
      ]
    },
     "legend": null
    },
    "color": {
     "field": "count",
     "type": "quantitative",
     "scale": {
      "scheme": "oranges",
      "domain": [
       0,
       200
      ]
     },
     "legend": null
    },
    "tooltip": [
     {
      "field": "accepted_name",
      "title": "Genus"
     },
     {
      "field": "count",
      "title": "Occurrences"
     }
    ]
   }
  },
  {
   "mark": {
    "type": "text",
    "align": "center",
    "baseline": "middle",
    "dy": 26,
    "fontSize": 12,
    "color": "#555"
   },
   "encoding": {
    "text": {
     "field": "count",
     "type": "quantitative",
     "format": ","
    }
   }
  }
 ]

  }  
]
}