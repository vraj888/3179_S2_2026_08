{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  
  "data": {
    "url": "https://raw.githubusercontent.com/vraj888/3179_S2_2026_08/main/dvp2/data/earth_occurences_location.csv",
    "format": {"type": "csv"}
  },
  
  "vconcat":[
    {
    "width":"container",
    "height": 250,
    "transform": [
    {
      "calculate": "(toNumber(datum.max_ma) + toNumber(datum.min_ma)) / 2",
      "as": "mid_ma"
    },
    {
      "calculate": "floor(datum.mid_ma / 5) * 5 + 2.5",
      "as": "time_bin"
    },
    {
      "aggregate": [{"op": "count", "as": "observations"}],
      "groupby": ["time_bin"]
    }
  ],
  "mark": {
    "type": "line",
    "color": "#333333",
    "strokeWidth": 2,
    "point": {"filled": true, "size": 28}
  },
  "encoding": 
    {
      "x": {
        "field": "time_bin",
        "type": "quantitative",
        "scale": {"domain": {"param": "periodSel"}, "reverse": true, "nice": false},
        "axis": {"title": "Millions of years ago"}
      },
      "y": {
        "field": "observations",
        "type": "quantitative",
        "title": "Number of observations",
        "scale": {"type": "log"}
      },
      "tooltip": [
        {"field": "time_bin", "type": "quantitative", "title": "Time (Ma)"},
        {"field": "observations", "type": "quantitative", "title": "Observations"}
      ]
    }
  },
  {
      "width": "container",
      "height": 40,
      "data": {"values": [
        {"period": "Triassic",   "start_ma": 251.9, "end_ma": 201.4},
        {"period": "Jurassic",   "start_ma": 201.4, "end_ma": 145},
        {"period": "Cretaceous", "start_ma": 145,   "end_ma": 66},
        {"period": "Paleogene",  "start_ma": 66,    "end_ma": 23.03},
        {"period": "Neogene",    "start_ma": 23.03, "end_ma": 2.58},
        {"period": "Quaternary", "start_ma": 2.58,  "end_ma": 0}
      ]},
      "transform": [
        {"calculate": "'Period'", "as": "row"},
        {"calculate": "(datum.start_ma + datum.end_ma) / 2", "as": "mid"}
       
      ],
      "layer": [
        {
          "params": [{"name": "periodSel", "select": {"type": "interval", "encodings": ["x"]}}],
          "mark": {"type": "rect", "cursor": "pointer", "stroke": "white", "strokeWidth": 1},
          
          "encoding": {
            "x": {"field": "start_ma", "type": "quantitative",
                  "scale": {"reverse": false, "domain": [252, 0], "nice": false},
                  "axis": {"title": "Millions of years ago"}},
            "x2": {"field": "end_ma"},
            "y": {"field": "row", "type": "nominal",
                  "axis": {"title": null, "labels": false, "ticks": false, "domain": false, "minExtent": 50}},
            "color": {"field": "period", "type": "nominal", "legend": null,
              "scale": {
                "domain": ["Triassic","Jurassic","Cretaceous","Paleogene","Neogene","Quaternary"],
                "range": ["#964ea4","#56bed2","#94cf6b","#fdaa6f","#ffea3f","#fafa94"]}},
            "opacity": {"condition": {"param": "periodSel", "value": 1}, "value": 0.4}
          }
        },
        {
          "transform": [{"filter": "datum.start_ma - datum.end_ma > 20"}],
          "mark": {"type": "text", "fontSize": 12, "fontWeight": "bold", "color": "#222"},
          "encoding": {
            "x": {"field": "mid", "type": "quantitative",
                  "scale": {"reverse": true, "domain": [252, 0], "nice": false}},
            "y": {"field": "row", "type": "nominal"},
            "text": {"field": "period"}
          }
        }
      ]
    },
  {
    "width": 800,
  "height": 450,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/ne_110m_admin_0_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
      },
      "mark": {"type": "geoshape", "fill": "lightgray", "stroke": "white"}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/7_others/oceans.topojson",
        "format": {"type": "topojson", "feature": "oceans"}
      },
      "mark": {"type": "geoshape", "fill": "skyblue"}
    },
  
    {
      "data": {
        "url": "https://raw.githubusercontent.com/vraj888/3179_S2_2026_08/refs/heads/main/dvp2/data/earth_occurences_location.csv",
        "format": {"type": "csv"}
      },

      "mark": {"type": "circle", "color": "red", "opacity": 0.5, "size": 30},
      "transform": [
        {
          "calculate": "(toNumber(datum.max_ma) + toNumber(datum.min_ma)) / 2",
          "as": "mid_ma"
        },
        {"calculate": "datum.mid_ma", "as": "start_ma"},
        {"filter": {"param": "periodSel"}}
      ],
      "encoding": {
        "longitude": {"field": "lng", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "tooltip": [{"field": "mid_ma", "type": "quantitative", "title": "Approx. age (Ma)"}]
      }
    }
  ]
  },
  {
  
 "width": 800,
 "height": 340,
 
 "transform": [
  {
    "calculate": "(toNumber(datum.max_ma) + toNumber(datum.min_ma)) / 2",
    "as": "mid_ma"
  },
  {"calculate": "datum.mid_ma", "as": "start_ma"},
  {"filter": {"param": "periodSel"}},
  {"filter":"datum.accepted_rank === 'genus'"},
  {
   "aggregate": [
    {
     "op": "count",
     "as": "count"
    }
   ],
   "groupby": [
    "accepted_name"
   ]
  },
  {
   "window": [
    {
     "op": "row_number",
     "as": "rank"
    }
   ],
   "sort": [
    {
     "field": "count",
     "order": "descending"
    }
   ]
  },
  {
   "filter": "datum.rank <= 10"
  },
  {
   "calculate": "datum.rank === 10 ? 1 : (datum.rank - 1) % 2",
   "as": "col"
  },
  {
   "calculate": "floor((datum.rank - 1) / 2)",
   "as": "row"
  }
 ],
 "encoding": {
  "x": {
   "field": "col",
   "type": "quantitative",
   "axis": null,
   "scale": {
    "domain": [
     -0.5,
     2.5
    ]
   }
  },
  "y": {
   "field": "row",
   "type": "quantitative",
   "axis": null,
   "scale": {
    "domain": [
     3.5,
     -0.5
    ]
   }
  }
 },
 "layer": [
  {
   "mark": {
    "type": "text",
    "align": "center",
    "baseline": "middle",
    "fontWeight": "bold"
   },
   "encoding": {
    "text": {
     "field": "accepted_name",
     "type": "nominal"
    },
    "size": {
     "field": "count",
     "type": "quantitative",
     "scale": {
      "type": "sqrt",
      "zero": true,
      "range": [
       0,
       40
      ]
     },
     "legend": null
    },
    "color": {
     "field": "count",
     "type": "quantitative",
     "scale": {
      "scheme": "oranges",
      "domain": [
       0,
       200
      ]
     },
     "legend": null
    },
    "tooltip": [
     {
      "field": "accepted_name",
      "title": "Genus"
     },
     {
      "field": "count",
      "title": "Occurrences"
     }
    ]
   }
  },
  {
   "mark": {
    "type": "text",
    "align": "center",
    "baseline": "middle",
    "dy": 26,
    "fontSize": 12,
    "color": "#555"
   },
   "encoding": {
    "text": {
     "field": "count",
     "type": "quantitative",
     "format": ","
    }
   }
  }
 ]

  }
  
]
}