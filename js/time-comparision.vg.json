{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  
  "data": {
    "url": "https://raw.githubusercontent.com/vraj888/3179_S2_2026_08/refs/heads/main/dvp2/data/dinosauria_all.csv",
    "format": {
      "type": "csv"
    }
  },
  
    "concat": [

     {
        "title":"Paleogene",
    "width": 500,
    "height": "container",
    "layer":[
        {
            "data": {
                "url": "https://raw.githubusercontent.com/vraj888/3179_S2_2026_08/refs/heads/main/dvp2/js/gplates/topo/earth-110mya.json",
                "format": {"type": "topojson", "feature": "earth-110mya"}
            },
            "mark": {"type": "geoshape", "fill": "white", "stroke": "black"},
            "projection": {
                "type": "equalEarth"
                }
        },
    
        {
            "mark": {"type": "circle", "color": "darkmagenta", "opacity": 0.5, "size": 5},
            "transform": [
                {
                "calculate": "(toNumber(datum.max_ma) + toNumber(datum.min_ma)) / 2",
                "as": "mid_ma"
                },
                {"filter": "datum.max_ma <= 125 && datum.max_ma > 75"}
            ],
            "encoding": {
                "longitude": {"field": "paleolng", "type": "quantitative"},
                "latitude": {"field": "paleolat", "type": "quantitative"},
                "tooltip": [{"field": "mid_ma", "type": "quantitative", "title": "Approx. age (Ma)"}]
            }
        }
    ]
    },
     {
        "title":"Cretaceous",
    "width": 500,
    "height": "container",
    "layer":[
        {
            "data": {
                "url": "https://raw.githubusercontent.com/vraj888/3179_S2_2026_08/refs/heads/main/dvp2/js/gplates/topo/earth-150mya.json",
