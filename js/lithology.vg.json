{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "data": {
  "url": "https://raw.githubusercontent.com/vraj888/3179_S2_2026_08/main/dvp2/data/dinosauria_all.csv"
 },
 "transform": [
{"filter": "datum.lithology1 && datum.lithology1 !== 'not reported'"},
  {
   "calculate": "datum.lithology1 ? lower(trim(replace(datum.lithology1, /\\\"/g, ''))) : 'unknown'",
   "as": "lith"
  },
  {
   "lookup": "lith",
   "from": {
    "data": {
     "values": [
      {
       "lith": "sandstone",
       "lith_group": "Sandstone"
      },
      {
       "lith": "mudstone",
       "lith_group": "Mud and shale"
      },
      {
       "lith": "claystone",
       "lith_group": "Mud and shale"
      },
      {
       "lith": "siltstone",
       "lith_group": "Mud and shale"
      },
      {
       "lith": "shale",
       "lith_group": "Mud and shale"
      },
      {
       "lith": "siliciclastic",
       "lith_group": "Siliciclastic (unspecified)"
      },
      {
       "lith": "conglomerate",
       "lith_group": "Coarse (gravel)"
      },
      {
       "lith": "breccia",
       "lith_group": "Coarse (gravel)"
      },
      {
       "lith": "gravel",
       "lith_group": "Coarse (gravel)"
      },
      {
       "lith": "limestone",
       "lith_group": "Carbonate"
      },
      {
       "lith": "lime mudstone",
       "lith_group": "Carbonate"
      },
      {
       "lith": "carbonate",
       "lith_group": "Carbonate"
      },
      {
       "lith": "wackestone",
       "lith_group": "Carbonate"
      },
      {
       "lith": "grainstone",
       "lith_group": "Carbonate"
      },
      {
       "lith": "dolomite",
       "lith_group": "Carbonate"
      },
      {
       "lith": "chalk",
       "lith_group": "Carbonate"
      },
      {
       "lith": "packstone",
       "lith_group": "Carbonate"
      },
      {
       "lith": "reef rocks",
       "lith_group": "Carbonate"
      },
      {
       "lith": "rudstone",
       "lith_group": "Carbonate"
      },
      {
       "lith": "bindstone",
       "lith_group": "Carbonate"
      },
      {
       "lith": "framestone",
       "lith_group": "Carbonate"
      },
      {
       "lith": "marl",
       "lith_group": "Marl and mixed"
      },
      {
       "lith": "mixed carbonate-siliciclastic",
       "lith_group": "Marl and mixed"
      },
      {
       "lith": "tar",
       "lith_group": "Organic (coal, peat, tar)"
      },
      {
       "lith": "peat",
       "lith_group": "Organic (coal, peat, tar)"
      },
      {
       "lith": "coal",
       "lith_group": "Organic (coal, peat, tar)"
      },
      {
       "lith": "lignite",
       "lith_group": "Organic (coal, peat, tar)"
      },
      {
       "lith": "amber",
       "lith_group": "Organic (coal, peat, tar)"
      },
      {
       "lith": "tuff",
       "lith_group": "Volcanic"
      },
      {
       "lith": "ash",
       "lith_group": "Volcanic"
      },
      {
       "lith": "volcaniclastic",
       "lith_group": "Volcanic"
      },
      {
       "lith": "not reported",
       "lith_group": "Unknown"
      },
      {
       "lith": "unknown",
       "lith_group": "Unknown"
      }
     ]
    },
    "key": "lith",
    "fields": [
     "lith_group"
    ]
   },
   "default": "Other"
  },
  {
   "calculate": "(toNumber(datum.max_ma) + toNumber(datum.min_ma)) / 2",
   "as": "mid_ma"
  },
  {"filter": "(toNumber(datum.max_ma) + toNumber(datum.min_ma)) / 2 >= 2.58"},
  {
   "calculate": "datum.mid_ma >= 201.4 ? 'Triassic' : datum.mid_ma >= 143.1 ? 'Jurassic' : datum.mid_ma >= 66 ? 'Cretaceous' : datum.mid_ma >= 23.03 ? 'Paleogene' : datum.mid_ma >= 2.58 ? 'Neogene' : 'Quaternary'",
   "as": "period"
  },
  {
   "aggregate": [
    {
     "op": "count",
     "as": "count"
    }
   ],
   "groupby": [
    "period",
    "lith_group"
   ]
  }
 ],
 "width": 800,
 "height": 450,
 "mark": "bar",
 "encoding": {
  "x": {
   "field": "period",
   "type": "ordinal",
   "sort": ["Triassic", "Jurassic", "Cretaceous", "Paleogene", "Neogene", "Quaternary"],
   "title": "Geological period",
   "axis":{"labels": true,"labelAngle":-45}
  },
  "y": {
   "aggregate": "sum",
   "field": "count",
   "type": "quantitative",
   "stack": "normalize",
   "axis": {"title": "Percentage of occurrences", "format": ".0%","labels": true,"grid": true}
  },
  "color": {
   "field": "lith_group",
   "type": "nominal",
   "title": "Lithology",
   "scale": {
    "domain": ["Sandstone", "Mud and shale", "Siliciclastic (unspecified)", "Coarse (gravel)", "Carbonate", "Marl and mixed", "Organic (coal, peat, tar)", "Volcanic", "Other", "Unknown"],
    "range": ["#e0b162", "#8c6d62", "#c9b79c", "#b5651d", "#6baed6", "#74c4b8", "#2b2b2b", "#d94841", "#9467bd", "#d9d9d9"]
   },
   "legend": {"orient": "right"}
  },
  "tooltip": [
   {"field": "period", "type": "nominal", "title": "Period"},
   {"field": "lith_group", "type": "nominal", "title": "Lithology"},
   {"field": "count", "type": "quantitative", "title": "Occurrences", "format": ","}
  ]
 },
 "config": {
  "view": {
   "stroke": null
  },
  "axis": {
   "domain": false,
   "ticks": false,
   "labels": false,
   "grid": false
  }
 }
}