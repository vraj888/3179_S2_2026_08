{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "Australia's dinosaur dig sites", "subtitle": "Circle size shows the count for each state. Use the menu to change what is counted.", "anchor": "start"},
  "width": "container",
  "height": 500,
  "projection": {"type": "mercator", "center": [134, -28], "scale": 700},
  "params": [
    {
      "name": "metric",
      "value": "sites",
      "bind": {
        "input": "select",
        "options": ["sites", "fossils", "genera"],
        "labels": ["Dig sites", "Fossil records", "Different genera"],
        "name": "Count: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/vraj888/3179_S2_2026_08/main/js/au-states-topo.json",
        "format": {"type": "topojson", "feature": "STE_2021_AUST_GDA2020"}
      },
      "mark": {"type": "geoshape", "fill": "#ece6dc", "stroke": "white"},
      "encoding": {
        "tooltip": [{"field": "properties.STE_NAME21", "type": "nominal", "title": "State or territory"}]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/vraj888/3179_S2_2026_08/main/js/ne_10m_rivers_australia.json",
        "format": {"type": "topojson", "feature": "ne_10m_rivers_australia"}
      },
      "mark": {"type": "geoshape", "filled": false, "stroke": "lightblue", "strokeWidth": 0.6}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/vraj888/3179_S2_2026_08/main/dvp2/data/dinosauria_all.csv",
        "format": {"type": "csv", "parse": {"max_ma": "number", "lat": "number", "lng": "number"}}
      },
      "transform": [
        {"filter": "datum.cc === 'AU' && datum.state && datum.max_ma > 66 && isValid(datum.lat)"},
        {"aggregate": [
            {"op": "distinct", "field": "collection_no", "as": "sites"},
            {"op": "count", "as": "fossils"},
            {"op": "distinct", "field": "genus", "as": "genera"}
          ],
         "groupby": ["state"]},
         {"lookup": "state",
          "from": {
            "data": {"values": [
              {"state": "Western Australia",  "clng": 122.0, "clat": -25.5},
              {"state": "Northern Territory", "clng": 133.4, "clat": -19.5},
              {"state": "South Australia",    "clng": 135.5, "clat": -30.0},
              {"state": "Queensland",         "clng": 144.5, "clat": -22.5},
              {"state": "New South Wales",    "clng": 146.9, "clat": -32.3},
              {"state": "Victoria",           "clng": 144.3, "clat": -36.9},
              {"state": "Tasmania",           "clng": 146.6, "clat": -42.0}
            ]},
            "key": "state",
            "fields": ["clng", "clat"]
          }},
        {"calculate": "metric === 'sites' ? datum.sites : metric === 'fossils' ? datum.fossils : datum.genera", "as": "value"}
      ],
      "layer": [
        {
          "mark": {"type": "circle", "color": "#A8582A", "opacity": 0.75, "stroke": "white", "strokeWidth": 1.5},
          "encoding": {
            "longitude": {"field": "clng", "type": "quantitative"},
            "latitude": {"field": "clat", "type": "quantitative"},
            "size": {
              "field": "value", "type": "quantitative",
              "scale": {"range": [100, 3500], "zero": true},
              "legend": {"title": "Count", "orient": "bottom-left", "symbolFillColor": "#A8582A", "symbolStrokeColor": "white"}
            },
            "tooltip": [
              {"field": "state", "type": "nominal", "title": "State"},
              {"field": "sites", "type": "quantitative", "title": "Dig sites"},
              {"field": "fossils", "type": "quantitative", "title": "Fossil records"},
              {"field": "genera", "type": "quantitative", "title": "Different genera"}
            ]
          }
        },
        {
          "mark": {"type": "text", "fontSize": 12, "fontWeight": "bold", "color": "#333", "dy": -4},
          "encoding": {
            "longitude": {"field": "clng", "type": "quantitative"},
            "latitude": {"field": "clat", "type": "quantitative"},
            "text": {"field": "value", "type": "quantitative"}
          }
        },
        {
          "mark": {"type": "text", "fontSize": 10, "color": "#333", "dy": 10},
          "encoding": {
            "longitude": {"field": "clng", "type": "quantitative"},
            "latitude": {"field": "clat", "type": "quantitative"},
            "text": {"field": "state", "type": "nominal"}
          }
        }
      ]
    }
  ]
}